import math
import argparse
import os
from collections import Counter

import torch
import torch.nn as nn
import torch.optim as optim

from torch.utils.data import DataLoader, Dataset
from torch.nn.utils.rnn import pad_sequence

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Using device:", device)


# ================= 数据 =================
def read_file(path):
    with open(path, encoding="utf-8") as f:
        return [l.strip() for l in f]


def tokenize(x):
    return x.lower().split()


def build_vocab(sents):
    counter = Counter()
    for s in sents:
        counter.update(tokenize(s))

    vocab = {"<pad>":0,"<sos>":1,"<eos>":2,"<unk>":3}
    for w,f in counter.items():
        if f>=2 and w not in vocab:
            vocab[w] = len(vocab)
    return vocab


def numericalize(s,v):
    return torch.tensor([v.get(t,3) for t in ["<sos>"]+tokenize(s)+["<eos>"]])


class MyDataset(Dataset):
    def __init__(self,en,de,sv,tv):
        self.en = read_file(en)[:2000]
        self.de = read_file(de)[:2000]
        self.sv = sv
        self.tv = tv

    def __len__(self): return len(self.en)

    def __getitem__(self,i):
        return numericalize(self.en[i],self.sv), numericalize(self.de[i],self.tv)


def collate(batch,pad):
    s,t = zip(*batch)
    return pad_sequence(s,True,pad), pad_sequence(t,True,pad)


def load(batch=16):
    path=".data/multi30k"

    en = os.path.join(path,"train.en")
    de = os.path.join(path,"train.de")
    ven = os.path.join(path,"val.en")
    vde = os.path.join(path,"val.de")

    sv = build_vocab(read_file(en))
    tv = build_vocab(read_file(de))

    train = MyDataset(en,de,sv,tv)
    val = MyDataset(ven,vde,sv,tv)

    pad = tv["<pad>"]

    return (
        DataLoader(train,batch,True,collate_fn=lambda b:collate(b,pad)),
        DataLoader(val,batch,False,collate_fn=lambda b:collate(b,pad)),
        sv,tv
    )


# ================= 模型 =================
class MHA(nn.Module):
    def __init__(self,d_model,n_head,use_attention=True):
        super().__init__()
        self.use_attention = use_attention
        self.dk = d_model//n_head
        self.n_head = n_head

        self.q = nn.Linear(d_model,d_model)
        self.k = nn.Linear(d_model,d_model)
        self.v = nn.Linear(d_model,d_model)
        self.o = nn.Linear(d_model,d_model)

    def forward(self,q,k,v,mask=None):

        if not self.use_attention:
            return v

        B = q.size(0)

        Q = self.q(q).view(B,-1,self.n_head,self.dk).transpose(1,2)
        K = self.k(k).view(B,-1,self.n_head,self.dk).transpose(1,2)
        V = self.v(v).view(B,-1,self.n_head,self.dk).transpose(1,2)

        score = torch.matmul(Q,K.transpose(-2,-1))/math.sqrt(self.dk)

        if mask is not None:
            score = score.masked_fill(mask==0,-1e9)

        attn = torch.softmax(score,-1)
        out = torch.matmul(attn,V)

        out = out.transpose(1,2).contiguous().view(B,-1,self.n_head*self.dk)

        return self.o(out)


class Layer(nn.Module):
    def __init__(self,d_model,use_residual,use_attention):
        super().__init__()
        self.use_residual = use_residual

        self.attn = MHA(d_model,2,use_attention)
        self.ff = nn.Sequential(
            nn.Linear(d_model,512),
            nn.ReLU(),
            nn.Linear(512,d_model)
        )

        self.n1 = nn.LayerNorm(d_model)
        self.n2 = nn.LayerNorm(d_model)

    def forward(self,x,mask):
        a = self.attn(x,x,x,mask)
        x = self.n1(x+a) if self.use_residual else self.n1(a)

        f = self.ff(x)
        x = self.n2(x+f) if self.use_residual else self.n2(f)

        return x


class Transformer(nn.Module):
    def __init__(self,sv,tv,use_residual=True,use_attention=True):
        super().__init__()

        d_model = 128

        self.se = nn.Embedding(sv,d_model)
        self.te = nn.Embedding(tv,d_model)

        self.layers = nn.ModuleList([
            Layer(d_model,use_residual,use_attention)
            for _ in range(2)
        ])

        self.fc = nn.Linear(d_model,tv)

    def forward(self,s,t,mask):

        x = self.se(s)
        for l in self.layers:
            x = l(x,mask)  # encoder ✔

        y = self.te(t)
        for l in self.layers:
            y = l(y,None)  

        return self.fc(y)


# ================= 训练 =================
def make_mask(x,pad):
    return (x!=pad).unsqueeze(1).unsqueeze(2)


def train(model,loader,opt,crit,pad):
    model.train()
    total=0

    for s,t in loader:
        s,t = s.to(device),t.to(device)

        t_in = t[:,:-1]
        t_out = t[:,1:]

        mask = make_mask(s,pad)

        o = model(s,t_in,mask)

        loss = crit(o.reshape(-1,o.size(-1)), t_out.reshape(-1))

        opt.zero_grad()
        loss.backward()
        opt.step()

        total += loss.item()

    return total/len(loader)


def evaluate(model,loader,crit,pad):
    model.eval()
    total=0

    with torch.no_grad():
        for s,t in loader:
            s,t = s.to(device),t.to(device)

            t_in = t[:,:-1]
            t_out = t[:,1:]

            mask = make_mask(s,pad)

            o = model(s,t_in,mask)

            loss = crit(o.reshape(-1,o.size(-1)), t_out.reshape(-1))

            total += loss.item()

    return total/len(loader)


# ================= 主函数 =================
def run(args):
    train_loader,val_loader,sv,tv = load(args.batch)

    pad = tv["<pad>"]

    if args.mode=="baseline":
        ur,ua=True,True
    elif args.mode=="no_residual":
        ur,ua=False,True
    else:
        ur,ua=True,False

    model = Transformer(len(sv),len(tv),ur,ua).to(device)

    opt = optim.Adam(model.parameters(),1e-4)
    crit = nn.CrossEntropyLoss(ignore_index=pad)

    for e in range(args.epoch):
        tl = train(model,train_loader,opt,crit,pad)
        vl = evaluate(model,val_loader,crit,pad)

        print(f"Epoch {e+1} | Train {tl:.3f} | Val {vl:.3f}")


if __name__=="__main__":
    p=argparse.ArgumentParser()

    p.add_argument("--mode",default="no_attention",
                   choices=["baseline","no_residual","no_attention"])
    p.add_argument("--epoch",type=int,default=10)
    p.add_argument("--batch",type=int,default=16)

    args=p.parse_args()

    run(args)
